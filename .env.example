# TabPilot Environment Variables
# Note: For security, never place service role keys or secret AI provider keys in client-side bundles.

# Optional Supabase Integration (for cloud sync & authentication)
# Required only if opt-in cloud synchronization is enabled
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Server-Side Secrets (Supabase Edge Functions / Backend only - NEVER prefix with VITE_)
# Required only if self-hosting the backend or running Supabase local development
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-server-only
AI_PROVIDER_API_KEY=your-ai-provider-api-key-server-only
AI_MODEL=gpt-4o-mini
